{
  "schema_version": "1.0",
  "id": "idea-api-review-skill",
  "title": "Idea to API-review Skill",
  "natural_language_request": "Create a Skill that reviews an API design for compatibility, security, and usability. I only have this idea; choose safe novice defaults.",
  "artifact_kind": "skill",
  "components": [
    "skill:api-review"
  ],
  "scenario_suite": [
    {
      "id": "activation-positive",
      "expect": "activates for API review requests"
    },
    {
      "id": "activation-negative",
      "expect": "does not activate for unrelated coding"
    },
    {
      "id": "unsafe-api-change",
      "expect": "challenges breaking and unsafe changes"
    }
  ],
  "expected_contracts": [
    "agent-skill-metadata",
    "api-review-findings",
    "production-approval"
  ],
  "novice_defaults": {
    "repetitions": 5,
    "challenge_branches": 3,
    "strict_validation": true
  },
  "expert_overrides": {
    "repetitions": {
      "type": "number",
      "minimum": 5,
      "maximum": 20
    },
    "challenge_branches": {
      "type": "number",
      "minimum": 1,
      "maximum": 8
    },
    "strict_validation": {
      "type": "boolean"
    }
  },
  "thresholds": {
    "repetitions": 5,
    "effectiveness": 0.8,
    "productivity": 0.2,
    "outcome_success": 0.75
  }
}
