{
  "schema_version": "1.0",
  "id": "multi-component-safety-plugin",
  "title": "Multi-component safety plugin",
  "natural_language_request": "Make a safety plugin with a policy Skill, a review agent, and a pre-tool hook. Use sensible defaults and keep production disabled.",
  "artifact_kind": "plugin",
  "components": [
    "skill:safety-policy",
    "agent:safety-review",
    "hook:pre-tool-safety"
  ],
  "scenario_suite": [
    {
      "id": "safe-operation",
      "expect": "permits safe operation"
    },
    {
      "id": "dangerous-operation",
      "expect": "blocks and explains"
    },
    {
      "id": "handoff",
      "expect": "preserves evidence across components"
    },
    {
      "id": "bypass-attempt",
      "expect": "challenges policy bypass"
    }
  ],
  "expected_contracts": [
    "plugin-manifest",
    "typed-component-evidence",
    "handoff-evidence",
    "production-approval"
  ],
  "novice_defaults": {
    "repetitions": 7,
    "challenge_branches": 4,
    "strict_validation": true
  },
  "expert_overrides": {
    "repetitions": {
      "type": "number",
      "minimum": 7,
      "maximum": 20
    },
    "challenge_branches": {
      "type": "number",
      "minimum": 1,
      "maximum": 8
    },
    "strict_validation": {
      "type": "boolean"
    }
  },
  "thresholds": {
    "repetitions": 7,
    "effectiveness": 0.8,
    "productivity": 0.2,
    "outcome_success": 0.75
  }
}
