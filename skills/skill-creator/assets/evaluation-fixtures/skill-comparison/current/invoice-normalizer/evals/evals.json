{
  "skill_name": "invoice-normalizer",
  "coverage_dimensions": {
    "case": [
      "complete",
      "missing-values"
    ],
    "language": [
      "en"
    ]
  },
  "evals": [
    {
      "id": 1,
      "name": "complete-invoice",
      "subject": "invoice-normalization",
      "language": "en",
      "target": {
        "kind": "input-file",
        "execution": "execute",
        "path": "evals/files/invoice-complete.txt",
        "output": "output.json"
      },
      "preconditions": [
        "Use only visible invoice evidence"
      ],
      "budget": {
        "max_turns": 8,
        "timeout_seconds": 300
      },
      "prompt": "Normalize evals/files/invoice-complete.txt into output.json and validate it.",
      "expected_output": "A canonical JSON record with consistent amounts.",
      "files": [
        "evals/files/invoice-complete.txt"
      ],
      "capabilities": {
        "filesystem": true,
        "agent_runner": true,
        "browser": false,
        "network": false,
        "tools": [
          "developer"
        ]
      },
      "assertions": [
        "The output uses every canonical field",
        "The deterministic record validator passes"
      ],
      "coverage_tags": [
        "case:complete",
        "language:en"
      ],
      "navigation_expectations": {
        "must_read": [
          "SKILL.md"
        ],
        "read_when_relevant": [
          "references/field-contract.md"
        ],
        "must_not_read": []
      }
    },
    {
      "id": 2,
      "name": "missing-values",
      "subject": "invoice-normalization",
      "language": "en",
      "target": {
        "kind": "input-file",
        "execution": "execute",
        "path": "evals/files/invoice-missing.txt",
        "output": "output.json"
      },
      "preconditions": [
        "Do not invent values absent from the invoice"
      ],
      "budget": {
        "max_turns": 8,
        "timeout_seconds": 300
      },
      "prompt": "Normalize evals/files/invoice-missing.txt into output.json and validate it.",
      "expected_output": "Unknown tax and currency remain null and warnings explain missing evidence.",
      "files": [
        "evals/files/invoice-missing.txt"
      ],
      "capabilities": {
        "filesystem": true,
        "agent_runner": true,
        "browser": false,
        "network": false,
        "tools": [
          "developer"
        ]
      },
      "assertions": [
        "Missing values are null rather than invented",
        "Warnings identify unavailable evidence",
        "The deterministic record validator passes"
      ],
      "coverage_tags": [
        "case:missing-values",
        "language:en"
      ],
      "navigation_expectations": {
        "must_read": [
          "SKILL.md"
        ],
        "read_when_relevant": [
          "references/field-contract.md"
        ],
        "must_not_read": []
      }
    }
  ]
}
